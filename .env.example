# Example configuration for local development: `cp .env.example .env` works as is.
# Every value here is public. Never use them on a server reachable from the internet.
MONGODB_ROOT_USERNAME=hufly
MONGODB_ROOT_PASSWORD=hufly-local-db-password
# At least 32 bytes. For real deployments generate one: `openssl rand -base64 48`
JWT_SECRET=local-development-jwt-secret-not-for-production-use-0123456789
# Default test stable and admin, created on the first start if the email is unknown.
# Log in to the app with BOOTSTRAP_ADMIN_EMAIL / BOOTSTRAP_ADMIN_PASSWORD.
BOOTSTRAP_STABLE_NAME=Teststall
BOOTSTRAP_ADMIN_EMAIL=admin@hufly.test
BOOTSTRAP_ADMIN_PASSWORD=hufly-admin-2026
# Operator website for creating stables, at http://localhost:8080/operator-local (HTTP Basic, password needs 12+ characters).
# In production pick an unguessable path (e.g. /hb-7f3k2q) and a long random password.
OPERATOR_PATH=/operator-local
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=hufly-operator-2026
