# Copy to .env and fill in. .env is gitignored.
MONGODB_ROOT_USERNAME=hufly
MONGODB_ROOT_PASSWORD=change-me
# At least 32 random bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-at-least-32-random-bytes
# Optional, local development: creates a first stable with this admin on startup if the email is unknown.
BOOTSTRAP_STABLE_NAME=Teststall
BOOTSTRAP_ADMIN_EMAIL=admin@hufly.test
BOOTSTRAP_ADMIN_PASSWORD=change-me
